---
import info from "../../info.json";

const content = info.desktop.how_to_buy;
---

<section id="como-comprar" class="bg-bg-page">
  <div class="container-sestre py-10 md:py-14">
    <div class="text-center">
      <p class="text-[12px] font-semibold uppercase tracking-[0.18em] text-morado-500">
        {content.eyebrow}
      </p>
      <h2 class="mt-2 text-[27px] font-bold leading-tight text-ink">
        {content.title}
      </h2>
    </div>

    <ol class="mt-10 grid gap-8 md:grid-cols-3 md:gap-6 lg:gap-8">
      {content.steps.map((step) => (
        <li class="relative flex flex-col items-center gap-4 text-center">
          <span
            class="flex h-16 w-16 items-center justify-center rounded-circle bg-morado-100 text-2xl font-bold text-morado-500"
          >
            {step.number}
          </span>
          <div class="flex flex-col items-center gap-2">
            <h3 class="text-[17px] font-bold text-morado-900">
              {step.title}
            </h3>
            <p class="max-w-[300px] text-sm leading-relaxed text-muted">
              {step.description}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
